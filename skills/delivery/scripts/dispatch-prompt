#!/usr/bin/env bash
# Fill a dispatch template into a prompt file in the plan's workspace and print
# its path. The session agent dispatches "Read <path> and follow it" and never
# loads the template itself.
#
# Usage: dispatch-prompt implementer --plan PLAN --boundary N --worktree DIR
#
# implementer: writes one brief per task in the boundary's PR row, in order,
# then fills implementer-prompt.md into <workspace>/boundary-N-implementer.md.
# Exits non-zero when the boundary is not in the PR Boundaries table or a
# [PLACEHOLDER] is left unfilled.
set -euo pipefail

usage() {
  echo "usage: dispatch-prompt implementer --plan PLAN --boundary N --worktree DIR" >&2
  exit 2
}

[ $# -ge 1 ] || usage
mode=$1
shift
plan='' boundary='' worktree=''
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || usage
  case $1 in
    --plan) plan=$2 ;;
    --boundary) boundary=$2 ;;
    --worktree) worktree=$2 ;;
    *) usage ;;
  esac
  shift 2
done
[ -n "$plan" ] && [ -n "$boundary" ] || usage
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

here=$(cd "$(dirname "$0")" && pwd)
skill_dir=$(dirname "$here")
plan_abs=$(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")
workspace=$(bash "$here/workspace" "$plan")

# Print the task numbers in boundary N's row of the PR Boundaries table.
# Ranges such as "1–3" or "1-3" expand; commas separate entries.
boundary_tasks() {
  awk -v want="$1" '
    /^```/ { fence = !fence }
    fence { next }
    /^## / { insec = ($0 ~ /^## PR Boundaries[ \t]*$/); next }
    !insec || !/^\|/ { next }
    {
      n = split($0, cell, "|")
      for (i = 2; i < n; i++) { c = cell[i]; gsub(/^[ \t]+|[ \t]+$/, "", c); cell[i] = c }
      if (!pr) { for (i = 2; i < n; i++) { if (cell[i] == "PR") pr = i; if (cell[i] == "Tasks") tasks = i }; next }
      if (cell[pr] != want) next
      list = cell[tasks]
      gsub(/–|—/, "-", list)
      m = split(list, part, ",")
      for (j = 1; j <= m; j++) {
        p = part[j]; gsub(/[ \t]/, "", p)
        if (split(p, r, "-") == 2) { for (k = r[1]; k <= r[2]; k++) print k }
        else if (p != "") print p
      }
    }
  ' "$plan"
}

# Print the first of the given paths that exists, or "none".
first_existing() {
  local f
  for f in "$@"; do
    if [ -f "$f" ]; then
      echo "$f"
      return
    fi
  done
  echo none
}

check_filled() {
  if grep -Eq '\[[A-Z][A-Z_]*\]' "$1"; then
    grep -En '\[[A-Z][A-Z_]*\]' "$1" >&2
    echo "dispatch-prompt: unfilled placeholder in $1" >&2
    exit 1
  fi
}

case $mode in
  implementer)
    [ -n "$worktree" ] && [ -d "$worktree" ] || usage
    worktree=$(cd "$worktree" && pwd)
    tasks=$(boundary_tasks "$boundary")
    [ -n "$tasks" ] || { echo "boundary $boundary is not in the PR Boundaries table of $plan" >&2; exit 1; }

    briefs=
    for t in $tasks; do
      brief=$(bash "$here/task-brief" "$plan" "$t" | sed -n 's/^wrote \(.*\): [0-9]* lines$/\1/p')
      briefs+="- Task $t: $brief"$'\n'
    done

    main_root=$(dirname "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)")
    agents=$(first_existing "$worktree/AGENTS.md" "$main_root/AGENTS.md")
    policy=$(first_existing "$worktree/.toolbelt/worktree-policy.md" "$main_root/.toolbelt/worktree-policy.md")

    prompt=$(cat "$skill_dir/implementer-prompt.md")
    prompt=${prompt//"[BOUNDARY]"/$boundary}
    prompt=${prompt//"[PLAN]"/$plan_abs}
    prompt=${prompt//"[WORKTREE]"/$worktree}
    prompt=${prompt//"[BRIEFS]"/${briefs%$'\n'}}
    prompt=${prompt//"[PROJECT_RULES]"/AGENTS.md: $agents; worktree policy: $policy}
    prompt=${prompt//"[LOOK_FOR]"/$(dirname "$skill_dir")/requesting-code-review/code-reviewer.md}

    out="$workspace/boundary-$boundary-implementer.md"
    printf '%s\n' "$prompt" > "$out"
    check_filled "$out"
    echo "$out"
    ;;
  *) usage ;;
esac
