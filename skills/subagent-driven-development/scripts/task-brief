#!/usr/bin/env bash
# Write one task's brief: the plan's shared sections (Global Constraints,
# Known Gotchas, Data Model) followed by the task's full text, into a file the
# implementer reads in one call. The task text never passes through the
# orchestrator's context, and the implementer gets the plan-wide sections every
# task implicitly includes.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.toolbelt/sdd/<plan-basename>-<digest>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

task=$(awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
  }
  intask { print }
' "$plan"; echo x)
task=${task%x}  # the sentinel keeps the task's trailing newlines intact

if [ -z "$task" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

# A shared section runs from its "## " heading to the next "#"/"##" heading or
# a "---" rule, ignoring headings inside code fences.
shared=$(awk '
  /^```/ { infence = !infence }
  !infence && (/^##?[ \t]/ || /^---[ \t]*$/) {
    inshared = ($0 ~ /^##[ \t]+(Global Constraints|Known Gotchas|Data Model)[ \t]*$/)
  }
  inshared { print }
' "$plan")

{
  if [ -n "$shared" ]; then
    printf '%s\n\n' "$shared"
  fi
  printf '%s' "$task"
} > "$out"

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
